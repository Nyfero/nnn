# ── Général ──────────────────────────────────────────────
# Adresse servie par Caddy. ":80" en local, "myprout.fr" en prod (HTTPS auto)
SITE_ADDRESS=:80
NODE_ENV=development
FRONTEND_URL=http://localhost

# ── Core : base de données ───────────────────────────────
CORE_DB_NAME=myprout_core
CORE_DB_USER=myprout
CORE_DB_PASSWORD=change-me
CORE_DB_ROOT_PASSWORD=change-me-root

# ── Core : JWT (clés générées par scripts/gen-keys.sh) ───
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# ── Core : admin initial (seed) ──────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=Myprout
ADMIN_PASSWORD=change-me

# ── Core : emails ────────────────────────────────────────
RESEND_API_KEY=

# ── Secrets d'enregistrement des modules (un par module) ─
MODULE_SECRET_PASSWORDS=change-me-long-random
MODULE_SECRET_SERVERS=change-me-long-random
MODULE_SECRET_FILES=change-me-long-random

# ── Module passwords ─────────────────────────────────────
PASSWORDS_DB_NAME=myprout_passwords
PASSWORDS_DB_USER=myprout_pw
PASSWORDS_DB_PASSWORD=change-me
PASSWORDS_DB_ROOT_PASSWORD=change-me-root
LOGO_DEV_TOKEN=

# ── Module server ────────────────────────────────────────
SERVERS_DB_NAME=myprout_servers
SERVERS_DB_USER=myprout_srv
SERVERS_DB_PASSWORD=change-me
SERVERS_DB_ROOT_PASSWORD=change-me-root

# ── Module files ─────────────────────────────────────────
FILES_DB_NAME=myprout_files
FILES_DB_USER=myprout_files
FILES_DB_PASSWORD=change-me
FILES_DB_ROOT_PASSWORD=change-me-root
FILES_DATA_DIR=./data/files      # où sont stockés les fichiers (voir §7)
FILES_DEFAULT_QUOTA=1GB          # quota par utilisateur (5 utilisateurs = 5 Go à réserver)
FILES_TRASH_DAYS=7               # durée de conservation dans la corbeille
FILES_MIN_FREE=1GB               # espace disque toujours laissé libre (voir §5)
FILES_MAX_UPLOAD=

# ── Tests de bout en bout (docker-compose.e2e.yml, jamais en production) ──
E2E_TOKEN=
