generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model passwords {
  password_id    Int       @id @default(autoincrement())
  user_id        Int // identifiant du core (pas de clé étrangère : autre base)
  title          String?   @db.VarChar(191)
  username       String?   @db.VarChar(191)
  password       String?   @db.Text // chiffré côté client (AES-GCM, clé dérivée du module)
  email          String?   @db.VarChar(191)
  note           String?   @db.Text
  is_compromised Boolean   @default(false)
  is_stared      Boolean   @default(false)
  is_deleted     Boolean   @default(false)
  deleted_time   DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime? @updatedAt

  @@index([user_id])
}
