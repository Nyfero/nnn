{
  "name": "myprout",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "packages/*",
    "core/*",
    "modules/*/*"
  ],
  "scripts": {
    "test": "npm test -w packages/sdk -w core/backend",
    "test:e2e": "node --env-file=.env --test --test-force-exit --test-concurrency=1 e2e/*.test.mjs",
    "build": "npm run build -w core/frontend -w modules/passwords/frontend"
  }
}
