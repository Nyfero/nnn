# Point d'entrée unique : tout est sur la même origine,
# donc cookies (sameSite=strict) et IndexedDB sont partagés entre core et modules.
{$SITE_ADDRESS::80} {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Sans effet en HTTP ; en HTTPS, le navigateur n'utilisera plus que HTTPS pendant 1 an
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Routes réservées aux appels entre services (core <-> modules) : jamais exposées
	@internal path_regexp ^/api/[^/]+/internal(/|$)
	handle @internal {
		respond 404
	}

	# ── APIs ──
	handle /api/core/* {
		reverse_proxy core-backend:3000
	}
	handle /api/passwords/* {
		reverse_proxy passwords-backend:3000
	}
	handle /api/servers/* {
		reverse_proxy servers-backend:3000
	}


	# ── Frontends des modules (un bloc par module) ──
	@passwords path /passwords /passwords/*
	handle @passwords {
		reverse_proxy passwords-frontend:80
	}

	@servers path /servers /servers/*
	handle @servers {
		reverse_proxy servers-frontend:80
	}

	# ── Core frontend (lobby, login, profil, admin) : par défaut ──
	handle {
		reverse_proxy core-frontend:80
	}
}
